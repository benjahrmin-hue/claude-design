# BHH Living – Apache/IONOS config for the Next.js static export (trailingSlash: true)
# Ziel: /impressum und /impressum/ laden mit Status 200 – ohne Redirect-Loop.

Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# --- HTTPS erzwingen (IONOS-sicher, KEIN Loop) ---
# IONOS terminiert SSL über einen Proxy, daher ist %{HTTPS} im Backend immer "off".
# Eine naive Regel "RewriteCond %{HTTPS} off" würde sich endlos selbst aufrufen
# (ERR_TOO_MANY_REDIRECTS). Deshalb wird zusätzlich X-Forwarded-Proto geprüft:
# Nur weiterleiten, wenn der Besucher NICHT bereits über https kommt.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Vorhandene Dateien und Verzeichnisse unverändert ausliefern
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Saubere URLs: /pfad -> /pfad/index.html INTERN ausliefern (kein externer Redirect),
# das verhindert das Trailing-Slash-Ping-Pong mit DirectorySlash.
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

ErrorDocument 404 /404.html
